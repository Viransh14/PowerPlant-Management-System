# Power Plant Management System - Environment Configuration
# Copy this file to .env and set your secrets. Do NOT commit .env to version control.

# Server Network Binding
# 127.0.0.1 binds locally for secure Cloudflare Tunnel / reverse proxy deployment
HOST=127.0.0.1
PORT=3000

# Session Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace_with_a_secure_random_session_secret_32_chars_min
SESSION_TIMEOUT_MINUTES=120

# Cookie Security (Set to true when served over HTTPS, e.g., Cloudflare Tunnel / SSL reverse proxy)
COOKIE_SECURE=false

# Allowed Origins (Comma-separated origins. Leave empty for strict same-origin only)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authorized Administrator Oracle Usernames (Comma-separated, allowed to execute arbitrary SQL in Terminal)
ADMIN_USERS=powerplant,system,admin

# Default Windows ODBC DSN Name
DEFAULT_ODBC_DSN=PowerPlantDSN
